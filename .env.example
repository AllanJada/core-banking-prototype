# Copy to .env and replace every value before running anything that matters.
#
#   cp .env.example .env
#
# A real .env has already been generated for you with random values; this file
# is the template, and is the one that is committed. .env itself is gitignored.

# Signs the login tokens. HS256 needs at least 256 bits, so this must be 32+
# characters or the application refuses to start. Anyone holding this string can
# mint a valid token for any account, including a Central Bank overseer.
#   openssl rand -base64 48 | cut -c1-48
APP_JWT_SECRET=replace-me-with-at-least-32-random-characters

# Wraps the per-file AES-256-GCM data encryption keys. Must decode to exactly 32
# bytes or the application refuses to start. Anyone holding this key can decrypt
# every stored payslip and ISO 20022 payload.
#
# Changing this after files exist makes those files permanently unreadable —
# their DEKs were wrapped under the old key and nothing else can unwrap them.
#   openssl rand -base64 32
APP_STORAGE_MASTER_KEY=replace-me-with-base64-of-32-random-bytes

# Postgres credentials. POSTGRES_DB and POSTGRES_USER default to postgres
# in docker-compose.yml if you leave them out.
POSTGRES_PASSWORD=replace-me
#POSTGRES_DB=replace-me
#POSTGRES_USER=postgres
